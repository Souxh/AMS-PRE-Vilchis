@startuml
title Diagrama de Actividades - Sistema de Gestión de Pedidos

start

:Ingresar al sistema;
:Validar usuario;

if (¿Usuario válido?) then (Sí)
    :Mostrar menú principal;

    :Consultar catálogo de productos;

    if (¿Desea realizar un pedido?) then (Sí)
        :Seleccionar productos;
        :Registrar pedido;
        :Validar datos del pedido;

        if (¿Los datos son correctos?) then (Sí)
            :Guardar pedido;
            :Mostrar confirmación;
        else (No)
            :Mostrar mensaje de error;
        endif

    else (No)
        :Consultar historial de pedidos;
    endif

else (No)
    :Mostrar mensaje de error de acceso;
endif

stop
@enduml
